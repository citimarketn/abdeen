rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // الكتالوج والإعدادات: قراءة للجميع، كتابة للمسؤولين فقط
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }

    // بيانات الموردين (سرية): للمسؤولين فقط قراءةً وكتابة
    match /productPrivate/{id} { allow read, write: if isAdmin(); }

    // سلة كل مستخدم: له وحده، وبحقل cart فقط وبحجم محدود
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cart'])
        && request.resource.data.cart is list
        && request.resource.data.cart.size() <= 100;
      allow delete: if false;
    }

    // المسؤولون: يُضافون يدويًا من لوحة Firebase فقط (معرّف المستند = uid)
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // الطلبات: تُنشأ من الخادم فقط (Admin SDK يتجاوز القواعد)
    match /orders/{id} {
      allow create: if false;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
